while True:
    print(30*"-","calculadora",30*"-")
num1 = int(input("Digite o primeiro numero: "))
num2 = int(input("Digite o segundo numero: "))
print('1, soma')
print('2, subtração')
print('3, multiplicação')
print('4, divisão')
opcao = input('Digite a operação: (+,-,*,/): ')


match opcao:
    case '+':
     resultado = num1 + num2
     print(f'{num1} + {num2} = {resultado}')
     pass
    case '-':
     resultado = num1 - num2
     print(f'{num1} - {num2} = {resultado}')
     pass
    case '*':
     resultado = num1 * num2
     print(f'{num1} * {num2} = {resultado}')
     pass
    case '/':
     resultado = num1 / num2
     print(f'{num1} / {num2} = {resultado}')
     pass
     